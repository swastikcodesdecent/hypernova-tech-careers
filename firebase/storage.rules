rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    function isAuthenticated() {
      return request.auth != null;
    }

    function isCEO() {
      return isAuthenticated() && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'ceo';
    }

    // Application PDFs & E-Signatures
    match /applications/{appId}/{fileName} {
      allow read: if isAuthenticated() && (request.auth.token.email == resource.metadata.applicantEmail || isCEO());
      allow write: if isAuthenticated() && request.resource.size < 10 * 1024 * 1024; // 10MB limit
    }

    // Support Ticket Attachments
    match /support/{ticketId}/{fileName} {
      allow read, write: if isAuthenticated();
    }
  }
}
