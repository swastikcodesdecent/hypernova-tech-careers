rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions for Authorization & Role Verification
    function isAuthenticated() {
      return request.auth != null;
    }

    function isUser(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isCEO() {
      return isAuthenticated() && (
        request.auth.token.email == 'ceo@hypernovatech.in' ||
        (request.auth.token.email != null && request.auth.token.email.matches('.*ceo.*')) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'ceo')
      );
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.email == 'admin@hypernovatech.in' ||
        (request.auth.token.email != null && request.auth.token.email.matches('.*admin.*')) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'it_head')
      );
    }

    function isExecutive() {
      return isCEO() || isAdmin();
    }

    // Helper to check if System Maintenance Mode is Active
    function isMaintenanceActive() {
      return exists(/databases/$(database)/documents/settings/maintenance_config) &&
             get(/databases/$(database)/documents/settings/maintenance_config).data.enabled == true;
    }

    // SETTINGS COLLECTION (Real-time Theme & Maintenance Mode Configs)
    match /settings/{settingId} {
      allow read: if true;
      allow write: if true;
    }

    // USERS COLLECTION
    match /users/{userId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if isExecutive();
    }

    // APPLICATIONS COLLECTION
    match /applications/{appId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if isExecutive();
    }

    // DEPARTMENTS COLLECTION
    match /departments/{deptId} {
      allow read: if true;
      allow write: if true;
    }

    // SUPPORT TICKETS COLLECTION
    match /supportTickets/{ticketId} {
      allow read: if isAuthenticated();
      allow create, update: if isExecutive() || (!isMaintenanceActive() && isAuthenticated());
      allow delete: if isExecutive();
    }

    // NOTIFICATIONS COLLECTION
    match /notifications/{notifId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAuthenticated();
    }

    // TASKS / WORK ASSIGNMENTS COLLECTION
    match /tasks/{taskId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isExecutive() || (!isMaintenanceActive() && isAuthenticated());
    }

    // ANNOUNCEMENTS COLLECTION
    match /announcements/{id} {
      allow read: if true;
      allow create, update, delete: if isExecutive();
    }

    // OFFICIAL NOTICES COLLECTION
    match /officialNotices/{id} {
      allow read: if true;
      allow create, update, delete: if isExecutive();
    }

    // SUBMITTED IDEAS COLLECTION
    match /ideas/{id} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isExecutive() || (!isMaintenanceActive() && isAuthenticated());
    }

    // PROJECT UPDATES COLLECTION
    match /projectUpdates/{id} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isExecutive();
    }

    // AUDIT LOGS COLLECTION
    match /auditLogs/{logId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
    }
  }
}
